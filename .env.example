# Required environment variables for k6 load tests.
# Copy this file to .env and fill in the values, then run tests with:
#   k6 run -e VAR=value script.js
# Or source the file before running:
#   export $(grep -v '^#' .env | xargs) && k6 run script.js

# --- Common ---
BASE_URL=https://api-uatv2.tajhotels.com

# --- login.js (OTP Verification) ---
TEST_PHONE=7659086950
TEST_OTP=               # OTP received via SMS (never commit real values)
REF_ID=                 # Session-specific reference ID from generate-otp response
COUNTRY_CODE=+91
CODE_CHALLENGE=         # PKCE code challenge (generate per session)
CODE_VERIFIER=          # PKCE code verifier (generate per session)

# --- login2.js (OTP Generation) ---
RECAPTCHA_TOKEN=        # Single-use reCAPTCHA token (generate via browser)

# --- Taj_full_booking.js (Full Booking Flow) ---
CUSTOMER_HASH=          # Customer identifier hash
JWT_TOKEN=              # Valid JWT for authenticated endpoints
CLIENT_ID=              # Analytics/session client ID
